# Copy this to a private shell profile or .env file outside source control.
# Do not commit real credentials.

# CQG WebAPI demo default from CQG docs. AMP/CQG may provide a different
# production or broker-specific endpoint.
CQG_SERVER_URL=wss://demoapi.cqg.com
CQG_PRIVATE_LABEL=WebAPITest
CQG_CLIENT_APP_ID=WebAPITest
CQG_CLIENT_VERSION=nq-scalper-paper/0.1

# Your AMP/CQG demo or paper credentials.
CQG_USERNAME=
CQG_PASSWORD=

# Ask AMP/CQG for the exact WebAPI contract symbol and account ID that match
# your MotiveWave CQG connection. Do not guess this from backtest symbols.
CQG_CONTRACT_SYMBOL=
CQG_ACCOUNT_ID=

# Path to CQG's official WebAPIPythonSamples checkout, including WebAPI/*.py.
CQG_WEBAPI_SAMPLES_PATH=

